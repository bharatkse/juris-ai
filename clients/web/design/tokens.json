{
  "$schema": "https://schemas.tokens.studio/latest/tokens.schema.json",
  "color": {
    "primitive": {
      "ink": {
        "950": { "$type": "color", "$value": "#0F1C2E" },
        "800": { "$type": "color", "$value": "#1A2B44" },
        "600": { "$type": "color", "$value": "#3D4F66" },
        "400": { "$type": "color", "$value": "#7A8BA1" }
      },
      "paper": {
        "50": { "$type": "color", "$value": "#F7F4EE" },
        "0": { "$type": "color", "$value": "#FFFCF7" }
      },
      "line": {
        "200": { "$type": "color", "$value": "#E4DDD0" }
      },
      "gold": {
        "600": { "$type": "color", "$value": "#B8860B" },
        "100": { "$type": "color", "$value": "#F4E8C4" }
      },
      "danger": {
        "600": { "$type": "color", "$value": "#9B2C2C" },
        "50": { "$type": "color", "$value": "#FDECEC" }
      },
      "success": {
        "600": { "$type": "color", "$value": "#276749" },
        "50": { "$type": "color", "$value": "#E6F4EA" }
      },
      "info": {
        "600": { "$type": "color", "$value": "#2B4C7E" }
      }
    },
    "semantic": {
      "bg": {
        "app": { "$type": "color", "$value": "{color.primitive.paper.50}" },
        "sidebar": { "$type": "color", "$value": "{color.primitive.ink.950}" },
        "elevated": { "$type": "color", "$value": "{color.primitive.paper.0}" }
      },
      "text": {
        "primary": { "$type": "color", "$value": "{color.primitive.ink.950}" },
        "on-dark": { "$type": "color", "$value": "{color.primitive.paper.0}" },
        "muted": { "$type": "color", "$value": "{color.primitive.ink.600}" }
      },
      "border": {
        "default": { "$type": "color", "$value": "{color.primitive.line.200}" }
      },
      "accent": { "$type": "color", "$value": "{color.primitive.gold.600}" },
      "focus": { "$type": "color", "$value": "{color.primitive.gold.600}" }
    }
  },
  "spacing": {
    "4": { "$type": "dimension", "$value": "4px" },
    "8": { "$type": "dimension", "$value": "8px" },
    "12": { "$type": "dimension", "$value": "12px" },
    "16": { "$type": "dimension", "$value": "16px" },
    "24": { "$type": "dimension", "$value": "24px" },
    "32": { "$type": "dimension", "$value": "32px" },
    "48": { "$type": "dimension", "$value": "48px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "6px" },
    "md": { "$type": "dimension", "$value": "10px" },
    "lg": { "$type": "dimension", "$value": "16px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "type": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontWeight": 500,
        "fontSize": "28px",
        "lineHeight": "36px",
        "letterSpacing": "0em"
      }
    },
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontWeight": 600,
        "fontSize": "22px",
        "lineHeight": "28px",
        "letterSpacing": "0em"
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontWeight": 600,
        "fontSize": "16px",
        "lineHeight": "24px",
        "letterSpacing": "0em"
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontWeight": 400,
        "fontSize": "14px",
        "lineHeight": "22px",
        "letterSpacing": "0em"
      }
    },
    "body-serif": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Source Serif 4",
        "fontWeight": 400,
        "fontSize": "16px",
        "lineHeight": "26px",
        "letterSpacing": "0em"
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontWeight": 400,
        "fontSize": "12px",
        "lineHeight": "16px",
        "letterSpacing": "0em"
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontWeight": 500,
        "fontSize": "12px",
        "lineHeight": "16px",
        "letterSpacing": "0.04em",
        "textCase": "uppercase"
      }
    }
  }
}
