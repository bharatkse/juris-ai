# Server-only FastAPI base URL. Do not expose this as NEXT_PUBLIC_*.
BACKEND_API_URL=http://127.0.0.1:8001/api/v1

# Browser-visible feature flag. Streaming is enabled unless explicitly false.
NEXT_PUBLIC_CHAT_STREAMING=true

# Optional when running Playwright against another web origin.
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3100

# Dedicated reference-render server (avoids collisions with local services).
PLAYWRIGHT_DESIGN_BASE_URL=http://127.0.0.1:3107
