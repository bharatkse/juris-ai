# ------------------------------------------------------------------------------
# Developing on the backend from source instead? Use server/env.example
# and server/CONTRIBUTING.md -- this file only covers what the release
# bundle (api + postgres + redis + searxng) actually needs.
# ------------------------------------------------------------------------------

APP_NAME=Juris AI
APP_VERSION=0.1.0
DEBUG=false

# Real "production" environment behavior (logging verbosity, debug
# endpoints, stricter CORS) isn't implemented yet -- see claude.md's
# Known gaps. development is what the code actually supports today.
ENVIRONMENT=development

# setup.sh generates these for you -- leave as CHANGE_ME and it will
# fill them in with real random values on first run.
SECRET_KEY=replace-with-your-secret
JWT_SECRET_KEY=replace-with-your-jwt-secret-for-more-info-check-docs
JWT_ALGORITHM=HS256

# Pin the released image version. Leave unset to always run whatever
# docker-compose.yml's default (latest) resolves to.
JURIS_AI_VERSION=0.1.0
API_PORT=8001

# ------------------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------------------
DB_HOST=CHANGE_ME
DB_NAME=CHANGE_ME
DB_PORT=CHANGE_ME

# Admin/migration role -- owns the schema, runs Alembic. Also what the
# LangGraph checkpointer and admin-only scripts (purge_compliance_log.py,
# verify_compliance_log_privileges.py) use.
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME!

# Restricted runtime role -- local dev only (see docker/dependencies/init/
# postgres/01-create-app-role.sh). NOSUPERUSER, does not own the
# schema; this is what the app actually connects as for normal
# request handling. Must differ from DB_USER above -- that's the
# point of the split.
APP_DB_USER=CHANGE_ME
APP_DB_PASSWORD=CHANGE_ME!


# ------------------------------------------------------------------------------
# LLM & search -- GROQ_API_KEY is the one value setup.sh will prompt
# you for; everything else here has a working default.
# ------------------------------------------------------------------------------
GROQ_API_KEY=CHANGE_ME
BRAVE_API_KEY=CHANGE_ME
SEARXNG_BASE_URL=http://searxng:8080
# Local Ollama: the planner tries it first (LLM_LOCAL_BASE_URL/MODEL).
# LLM_LOCAL controls agent failover to it when Groq is unavailable (rate
# limit, timeout, connection error, 5xx). Off here: failover is meant for
# a GPU-hosted Ollama. On a CPU-only dev box a realistic agent decision
# takes minutes (~450 s measured), longer than the 120 s turn budget; the
# deadline safeguard stops that from hanging a request, but the call is
# cut off, so failover adds a wait and still fails. Set LLM_LOCAL=ollama
# on a GPU host; LLM_LOCAL_FAILOVER_MIN_SECONDS (default 60) is the least
# time a call must have left to be failed over.
# Failover covers the agents only. The answer judges (harmful content,
# groundedness) stay on Groq, so when Groq is fully down an answer the local
# model produced is still discarded: the user gets the refusal or the "couldn't
# verify" reply. That is logged as a warning and counted in
# juris_ai_failover_answers_discarded_total. Failover helps when only the
# agent model is rate-limited or erroring while the judge model still answers.
LLM_LOCAL=none
LLM_LOCAL_BASE_URL=http://ollama:11434
LLM_LOCAL_MODEL=qwen3:8b
# Most seconds the planner's local call may take (qwen3:8b on CPU: ~20 s
# warm, p95 ~38 s; ~80 s on a cold load, which the startup warm-up avoids).
# Past it, or on a local error, the plan is asked once of
# PLANNER_FAILOVER_PROVIDER within what is left of the request's deadline;
# if that fails too or no time is left, the request fails with 504
# PLANNING_TIMEOUT.
PLANNER_TIMEOUT_S=45
# "groq" (default) or empty for no planner failover. Failover planning uses
# the same Groq key and per-minute token limit as the agents.
PLANNER_FAILOVER_PROVIDER=groq
# How long Ollama keeps the model loaded after each call and after the
# startup warm-up (Ollama's own default is 5m).
LLM_LOCAL_KEEP_ALIVE=30m

# ------------------------------------------------------------------------------
# Optional: LangSmith tracing for LLM/agent behavior (off by default --
# sends conversation content to a third party when enabled, see the
# root README's Data Processing & Privacy section).
# ------------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=CHANGE_ME
LANGSMITH_PROJECT=CHANGE_ME
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING_V2=true

# ------------------------------------------------------------------------------
# Per-user rate limiting and token quota. Defaults shown are
# placeholders, not derived from real traffic/cost data; to size them,
# run scripts/usage_percentiles.py (tokens per request and per user per day).
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=20
# Max tokens one chat request may use, checked before each LLM call
# (413 REQUEST_TOKEN_QUOTA_EXCEEDED). Not applied to resumed turns.
TOKEN_QUOTA_PER_REQUEST=100000
# Max tokens per user per day (429 TOKEN_QUOTA_EXCEEDED; resets at
# midnight UTC). Every LLM call a chat turn makes counts (planner,
# agents, answer checks, guardrail judge), including resumed turns.
# Must be >= TOKEN_QUOTA_PER_REQUEST, or the server refuses to start.
# The old names RATE_LIMIT_REQUEST_TOKEN_QUOTA and
# RATE_LIMIT_DAILY_TOKEN_QUOTA are still read.
TOKEN_QUOTA_DAILY=2000000
# Chat attachments: max files per message, and bytes per file. Only
# PDF, DOCX, plain text and Markdown are accepted (422 otherwise).
UPLOAD_MAX_FILES=5
UPLOAD_MAX_FILE_BYTES=10485760

# ------------------------------------------------------------------------------
# Redis Configuration
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Opentelemetry configuration
# ------------------------------------------------------------------------------
OTEL_TRACING=true
OTEL_APP_VERSION="0.1.0"
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# ------------------------------------------------------------------------------
# Agent policy feature flags (config/agent_policy.py)
# ------------------------------------------------------------------------------
# Grants the "legal" agent's default policy the web_research tool.
# Off by default: web_research has no production track record yet and
# tool-permission enforcement (agent_policies table) was only made
# functional recently -- see src/agentic/README.md.
ENABLE_WEB_RESEARCH_FOR_LEGAL=false
# Grants the legal and contract agents the email/slack read tools and the
# email_send/slack_post send tools. Every send pauses for the user's own
# approval. Needs MCP_GMAIL_SERVER_URL / MCP_SLACK_SERVER_URL below.
ENABLE_MESSAGING_TOOLS=false
# Gmail / Slack MCP servers (streamable HTTP) behind those tools. Leave
# unset to register neither.
# MCP_GMAIL_SERVER_URL=
# MCP_SLACK_SERVER_URL=
# Most steps one execution plan may have. A plan over the limit isn't run;
# the user is asked to split the request.
PLAN_MAX_STEPS=6

# ------------------------------------------------------------------------------
# RAG evaluation
# ------------------------------------------------------------------------------
# Switches the faithfulness judge backend between the hand-rolled
# "legacy" judge and the ragas library's own metric. Note: lowercase,
# unlike every other setting in this file -- matches the field name in
# config/llm.py exactly (case-sensitive).
faithfulness_backend=legacy

# Only relevant when faithfulness_backend=ragas: opts out of the ragas
# package's own telemetry. Read by the ragas library itself, not by
# this codebase.
RAGAS_DO_NOT_TRACK=true
