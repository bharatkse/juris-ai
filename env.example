# ------------------------------------------------------------------------------
# Application configuration
# ------------------------------------------------------------------------------
APP_NAME=Legal AI Assistant
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=replace-with-your-secret
JWT_SECRET_KEY=replace-with-your-jwt-secret-for-more-info-check-docs
JWT_ALGORITHM=HS256

# ------------------------------------------------------------------------------
# Groq & LangSmith configuration
# ------------------------------------------------------------------------------
GROQ_API_KEY=
BRAVE_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=juris-ai-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING_V2=true

# ------------------------------------------------------------------------------
# PostgreSQL configuration
# ------------------------------------------------------------------------------
DB_NAME=CHANGE_ME
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME!
DB_HOST=CHANGE_ME
DB_PORT=CHANGE_ME

# ------------------------------------------------------------------------------
# Opentelemetry configuration
# ------------------------------------------------------------------------------
OTEL_TRACING=true
OTEL_APP_VERSION="0.1.0"
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
